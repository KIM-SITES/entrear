---
import Container from './Container.astro';
import DemoNotice from '@/components/ui/DemoNotice.astro';
---
<footer>
  <Container>
    <div class="footer-row"><DemoNotice /><a href="#inicio">Voltar ao início ↑</a></div>
    <p>Entrear Climatização é uma empresa fictícia. Fotografias ilustrativas não representam equipe ou serviços executados.</p>
  </Container>
</footer>
<style>
  footer { border-top: 1px solid var(--border-subtle); padding-block: var(--space-6); }
  .footer-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); }
  a { min-height: 44px; display: inline-flex; align-items: center; font-size: var(--type-small); }
  p { font-size: var(--type-caption); color: var(--text-secondary); max-width: 70ch; margin-top: var(--space-3); }
  @media (max-width: 47.99rem) { .footer-row { align-items: flex-start; flex-direction: column; gap: var(--space-2); } }
</style>
