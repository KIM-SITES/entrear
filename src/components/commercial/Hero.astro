---
import { Picture } from 'astro:assets';
import Container from '@/components/layout/Container.astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import ServiceSelector from './ServiceSelector.astro';
import { commercialMedia } from '@/data/commercial-media';
const photo = commercialMedia.room;
---
<section class="hero" id="inicio" aria-labelledby="titulo-principal" data-service-stage data-service="instalacao">
  <Container>
    <div class="hero-intro">
      <h1 id="titulo-principal">Conforto <span>tem medida.</span></h1>
      <div class="hero-lead"><div><p>Instalação e manutenção de ar-condicionado.</p><p class="audience">Para residências e pequenos negócios.</p></div><a class="main-action" href="#orcamento">Pedir orçamento <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-8 8H5l-3 2v-7a8 8 0 1 1 18-3Z" stroke="currentColor" stroke-width="1.4"/><path d="M7 10h8M7 14h5" stroke="currentColor" stroke-width="1.4"/></svg></a></div>
    </div>
    <figure>
      <div class="aperture-frame" data-aperture>
        <Picture src={photo.image} alt={photo.alt} widths={[480, 800, 1200, 1800]} sizes="(min-width: 90rem) 1328px, calc(100vw - 2.5rem)" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
        <span class="plane plane--middle-top" aria-hidden="true"></span><span class="plane plane--middle-bottom" aria-hidden="true"></span><span class="plane plane--end-top" aria-hidden="true"></span><span class="plane plane--end-bottom" aria-hidden="true"></span><span class="opening opening--middle" aria-hidden="true"></span><span class="opening opening--end" aria-hidden="true"></span>
      </div>
      <figcaption><span>{photo.disclaimer}</span><PhotoCredit author={photo.author} sourceUrl={photo.sourceUrl} provider={photo.provider} /></figcaption>
    </figure>
    <ServiceSelector />
  </Container>
</section>
<style>
  .hero-intro { padding-block: var(--space-7) var(--space-6); }
  h1 { font-size: clamp(3.5rem, 8.65vw, 8.25rem); line-height: 1.01; letter-spacing: -.04em; }
  .hero-lead { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); margin-top: var(--space-5); }
  .hero-lead p { font-size: var(--type-lead); line-height: 1.5; }
  .hero-lead .audience { margin-top: var(--space-1); font-size: var(--type-body); color: var(--text-secondary); }
  .main-action { display: inline-flex; gap: var(--space-6); align-items: center; justify-content: center; min-height: 58px; padding: var(--space-4) var(--space-5); background: var(--action-background); color: var(--action-text); text-decoration: none; font-weight: var(--weight-medium); flex: none; border-radius: var(--radius-control); }
  .main-action:hover { background: var(--action-background-hover); }
  .main-action svg { flex: none; }
  .aperture-frame { position: relative; height: clamp(380px, 38vw, 560px); isolation: isolate; overflow: hidden; }
  .aperture-frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .plane, .opening { position: absolute; background: var(--surface-page); pointer-events: none; }
  .plane { width: 26%; left: 58%; height: 16.6667%; }
  .plane--middle-top { top: 0; } .plane--middle-bottom { bottom: 0; }
  .plane--end-top, .plane--end-bottom { left: 84%; width: 16%; height: 33.3333%; }
  .plane--end-top { top: 0; } .plane--end-bottom { bottom: 0; }
  .opening { width: var(--space-2); height: 100%; top: 0; }
  .opening--middle { left: calc(58% - var(--space-1)); } .opening--end { left: calc(84% - var(--space-1)); }
  .hero[data-ready="true"] .plane { transition: transform var(--motion-duration-aperture) var(--motion-ease-standard); }
  .hero[data-service="manutencao"] .plane--middle-top, .hero[data-service="manutencao"] .plane--end-top { transform: translateY(-100%); }
  .hero[data-service="manutencao"] .plane--middle-bottom, .hero[data-service="manutencao"] .plane--end-bottom { transform: translateY(100%); }
  figcaption { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-3); color: var(--text-secondary); font-size: .75rem; line-height: 1.5; }
  @media (max-width: 47.99rem) {
    .hero-intro { padding-block: var(--space-6) var(--space-5); }
    h1 { font-size: clamp(2.8rem, 15.5vw, 4.8rem); line-height: 1.02; }
    h1 span { display: block; }
    .hero-lead { flex-direction: column; align-items: stretch; gap: var(--space-5); margin-top: var(--space-4); }
    .hero-lead p { font-size: 1rem; max-width: 34ch; }
    .hero-lead .audience { font-size: var(--type-small); }
    .main-action { min-height: 52px; padding-block: var(--space-3); font-size: var(--type-small); }
    .aperture-frame { height: clamp(225px, 64vw, 400px); }
    .aperture-frame :global(img) { object-position: 0 0; }
    .plane { left: 64%; width: 24%; } .plane--end-top, .plane--end-bottom { left: 88%; width: 12%; }
    .opening--middle { left: calc(64% - var(--space-1)); } .opening--end { left: calc(88% - var(--space-1)); }
    figcaption { flex-direction: column; gap: var(--space-1); font-size: .6875rem; }
  }
</style>
