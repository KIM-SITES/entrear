---
import Container from '@/components/layout/Container.astro';
import { editorialFAQs } from '@/data/editorial-content';
---
<section id="duvidas" class="faq" tabindex="-1" aria-labelledby="duvidas-titulo">
  <Container>
    <div class="faq-heading"><h2 id="duvidas-titulo">Antes de começar.</h2><p>Perguntas frequentes sobre os serviços e sobre o que você pode experimentar por aqui.</p></div>
    <div class="faq-layout"><p class="faq-aside">Instalação, manutenção<br />e uma demonstração<br />sem envio de dados.</p>
      <div class="questions">{editorialFAQs.map(faq => <details id={`duvida-${faq.id}`}><summary>{faq.question}<span class="disclosure" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div>
    </div>
  </Container>
</section>
<style>
  .faq { padding-block: var(--space-section); }
  .faq-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-7); padding-bottom: var(--space-7); }
  .faq-heading > * { max-width: 100%; }
  h2 { font-size: clamp(2.5rem, 4.5vw, 4.5rem); }
  .faq-heading > p { max-width: 37ch; color: var(--text-secondary); }
  .faq-layout { display: grid; grid-template-columns: .55fr 1.45fr; gap: var(--space-8); }
  .faq-aside { border-top: 2px solid var(--color-copper); padding-top: var(--space-5); color: var(--text-secondary); font-size: var(--type-small); }
  details { border-top: 1px solid var(--border-subtle); }
  details:last-child { border-bottom: 1px solid var(--border-subtle); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); min-height: 80px; padding: var(--space-5) var(--space-2); font-size: var(--type-lead); font-weight: var(--weight-medium); line-height: 1.4; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-copper); }
  summary:focus-visible { outline-offset: 0; }
  .disclosure { position: relative; flex: none; width: 20px; height: 20px; }
  .disclosure::before, .disclosure::after { content: ''; position: absolute; background: currentColor; inset: 9px 1px; }
  .disclosure::after { transform: rotate(90deg); }
  details[open] .disclosure::after { transform: rotate(0); }
  details[open] summary { color: var(--color-copper); }
  details > p { max-width: 69ch; padding: 0 var(--space-7) var(--space-6) var(--space-2); color: var(--text-secondary); }
  @media (max-width: 47.99rem) {
    .faq-heading { flex-direction: column; align-items: start; gap: var(--space-5); }
    .faq-layout { grid-template-columns: 1fr; gap: 0; }
    .faq-aside { display: none; }
    summary { min-height: 76px; font-size: 1.125rem; }
    details > p { padding-right: var(--space-2); font-size: var(--type-small); }
  }
</style>
