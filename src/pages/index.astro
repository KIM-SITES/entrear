---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Hero from '@/components/commercial/Hero.astro';
import Services from '@/components/commercial/Services.astro';
import QuoteSection from '@/components/commercial/QuoteSection.astro';
---
<BaseLayout title="Entrear Climatização — Conforto tem medida · demonstração">
  <SiteHeader slot="header" />
  <div data-commercial><Hero /><Services /><QuoteSection /></div>
  <SiteFooter slot="footer" />
</BaseLayout>
<script>
  import { createServiceState, serviceFromSearch } from '@/lib/service';
  import { initNavigation } from '@/scripts/navigation';
  import { initServiceSelection } from '@/scripts/service-selection';
  import { initQuoteForm } from '@/scripts/quote-form';
  const state = createServiceState(serviceFromSearch(window.location.search));
  initNavigation();
  initServiceSelection(state);
  initQuoteForm(state);
  document.documentElement.dataset.commercialReady = 'true';
</script>
<style is:global>
  html:has([data-commercial]) { --anchor-offset: 7.5rem; scroll-padding-block-start: 0; }
  @media (prefers-reduced-motion: no-preference) { html:has([data-commercial]) { scroll-behavior: smooth; } }
  @media (max-width: 47.99rem) { html:has([data-commercial]) { --anchor-offset: 1rem; } }
</style>
