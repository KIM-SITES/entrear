---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Hero from '@/components/commercial/Hero.astro';
import Services from '@/components/commercial/Services.astro';
import QuoteSection from '@/components/commercial/QuoteSection.astro';
import Applications from '@/components/editorial/Applications.astro';
import About from '@/components/editorial/About.astro';
import Process from '@/components/editorial/Process.astro';
import Coverage from '@/components/editorial/Coverage.astro';
import FAQ from '@/components/editorial/FAQ.astro';
import '@/styles/interactions.css';
---
<BaseLayout title="Entrear Climatização — Conforto tem medida · demonstração">
  <SiteHeader slot="header" />
  <div data-commercial><Hero /><Services /><Applications /><About /><Process /><Coverage /><FAQ /><QuoteSection /></div>
  <SiteFooter slot="footer" />
</BaseLayout>
<script>
  import { createServiceState, serviceFromSearch } from '@/lib/service';
  import { initNavigation } from '@/scripts/navigation';
  import { initServiceSelection } from '@/scripts/service-selection';
  import { initQuoteForm } from '@/scripts/quote-form';
  import { initSectionNavigation } from '@/scripts/section-navigation';
  const state = createServiceState(serviceFromSearch(window.location.search));
  initNavigation();
  initServiceSelection(state);
  initQuoteForm(state);
  initSectionNavigation();
  document.documentElement.dataset.commercialReady = 'true';
</script>
<style is:global>
  html:has([data-commercial]) { --anchor-offset: 7.5rem; scroll-padding-block-start: 0; }
  @media (prefers-reduced-motion: no-preference) { html:has([data-commercial]) { scroll-behavior: smooth; } }
  @media (max-width: 63.99rem) { html:has([data-commercial]) { --anchor-offset: 1rem; } }
</style>
